<mxfile host="Electron">
  <diagram name="Page-1" id="xsopB8_AdqvlsFtBoLMF">
    <mxGraphModel dx="6816" dy="3328" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="XGDfcc4M_P-qUN3EE2EP-3" edge="1" parent="1" source="XGDfcc4M_P-qUN3EE2EP-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="XGDfcc4M_P-qUN3EE2EP-2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XGDfcc4M_P-qUN3EE2EP-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Il y a quelques mois, en fin de matinée, j’ai mis plus d’une demie heure à faire un trajet direct qui normalement prend 11 à 12 minutes.&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: Helvetica;&quot;&gt;Tout ça à cause d’un malaise voyageur à Châtelet. Mon trajet était entre deux stations comportant des noms de scientifiques.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-family: Helvetica; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-family: Helvetica; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Quelles étaient ces deux stations ?&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-family: Helvetica; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-family: Helvetica; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Format du flag : 404CTF{les-halles_republique}&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="250" width="498" x="-129" y="-94" as="geometry" />
        </mxCell>
        <mxCell id="XGDfcc4M_P-qUN3EE2EP-5" edge="1" parent="1" source="XGDfcc4M_P-qUN3EE2EP-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="XGDfcc4M_P-qUN3EE2EP-4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XGDfcc4M_P-qUN3EE2EP-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;Nous avons 3 indices ici. Le premier, c&#39;est le temps de trajet ; 11~12 min. Ensuite, le deuxième, c&#39;est que l&#39;on sait que son trajet passe par Châtelet, ou du moins, que ce dernier peut être impacté par une perturbation à Châtelet. Et enfin, le troisième indice, c&#39;est que les deux stations de son trajet portent le noms de scientifiques.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="498" x="-129" y="236" as="geometry" />
        </mxCell>
        <mxCell id="XGDfcc4M_P-qUN3EE2EP-8" edge="1" parent="1" source="XGDfcc4M_P-qUN3EE2EP-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="XGDfcc4M_P-qUN3EE2EP-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XGDfcc4M_P-qUN3EE2EP-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;Ce que nous allons faire en premier lieu, ça va être de regarder le plan du métro parisien, en analysant quelles lignes passent par Châtelet.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="498" x="449" y="281" as="geometry" />
        </mxCell>
        <mxCell id="XGDfcc4M_P-qUN3EE2EP-11" edge="1" parent="1" source="XGDfcc4M_P-qUN3EE2EP-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="XGDfcc4M_P-qUN3EE2EP-10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XGDfcc4M_P-qUN3EE2EP-7" parent="1" style="shape=image;aspect=fixed;image=data:image/png,;imageBorder=default;sketch=1;curveFitting=1;jiggle=2;" value="" vertex="1">
          <mxGeometry height="800" width="800" x="1027" y="-74" as="geometry" />
        </mxCell>
        <mxCell id="XGDfcc4M_P-qUN3EE2EP-13" edge="1" parent="1" source="XGDfcc4M_P-qUN3EE2EP-10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="XGDfcc4M_P-qUN3EE2EP-12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XGDfcc4M_P-qUN3EE2EP-10" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 20px; font-family: Helvetica; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Châtelet, c&#39;est le cœur du métro parisien : c&#39;est là que le plus de lignes se croisent. Nous pouvons relever 5 lignes passant par Châtelet ; la 1, 4, 7, 11 et 14. Autant de ligne à analyse à travers deux variables ; des stations portant le nom de scientifiques, et un écart de trajet d&#39;11 à 12 min entre deux de ces stations.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="166" width="498" x="1178" y="791" as="geometry" />
        </mxCell>
        <mxCell id="XGDfcc4M_P-qUN3EE2EP-15" edge="1" parent="1" source="XGDfcc4M_P-qUN3EE2EP-12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="XGDfcc4M_P-qUN3EE2EP-14">
