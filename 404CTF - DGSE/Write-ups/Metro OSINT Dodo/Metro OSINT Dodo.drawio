        <mxCell id="XGDfcc4M_P-qUN3EE2EP-36" edge="1" parent="1" source="XGDfcc4M_P-qUN3EE2EP-26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="XGDfcc4M_P-qUN3EE2EP-35">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XGDfcc4M_P-qUN3EE2EP-26" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;textShadow=0;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); text-align: center;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;Après avoir analysé les 5 lignes, une, mène à une piste. La ligne 7, le trajet direct est estimé à ~11 min entre les deux stations&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/span&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); text-align: center; font-family: Helvetica; font-size: 20px;&quot;&gt;Censier-Daubenton&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); text-align: center; font-family: Helvetica; font-size: 20px;&quot;&gt; (naturaliste) et&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); text-align: center; font-family: Helvetica; font-size: 20px;&quot;&gt;Pierre et Marie Curie&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); text-align: center; font-family: Helvetica; font-size: 20px;&quot;&gt; (physiciens).&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 20px; font-family: Helvetica; text-align: center;&quot;&gt;&amp;nbsp;Deux noms de scientifiques, même ligne, la durée est cohérente : tous les critères semblent remplis… mais le flag est incorrect. Il faut donc chercher autrement.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="193.56" width="498" x="-693" y="1171.67" as="geometry" />
        </mxCell>
        <mxCell id="XGDfcc4M_P-qUN3EE2EP-38" edge="1" parent="1" source="XGDfcc4M_P-qUN3EE2EP-35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="XGDfcc4M_P-qUN3EE2EP-37">
