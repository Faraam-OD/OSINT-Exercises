        <mxCell id="XGDfcc4M_P-qUN3EE2EP-40" edge="1" parent="1" source="XGDfcc4M_P-qUN3EE2EP-37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="XGDfcc4M_P-qUN3EE2EP-39">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XGDfcc4M_P-qUN3EE2EP-42" edge="1" parent="1" source="XGDfcc4M_P-qUN3EE2EP-37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="XGDfcc4M_P-qUN3EE2EP-41">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="413" y="2285" />
              <mxPoint x="775" y="2285" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="XGDfcc4M_P-qUN3EE2EP-37" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;textShadow=0;" value="&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;Pivot : élargir aux noms composés moins évidents.&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;Certaines stations cachent un nom de scientifique dans un nom composé. Je me suis notamment intéressé à la station&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: Helvetica; font-size: 20px;&quot;&gt;&quot;&lt;b&gt;Montparnasse-Bienvenüe&lt;/b&gt;&quot; présent sur la ligne 4 — Bienvenüe est un nom propre ici, pas un mot de bienvenue.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: Helvetica; font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: Helvetica; font-size: 20px;&quot;&gt;J&#39;ai trouvé également une seconde station pouvant comporter un nom propre sur la même ligne (4) ; &quot;&lt;b&gt;Réaumur-Sébastopol&lt;/b&gt;&quot; — Réaumur est un physicien du XVIIIe siècle, pas un lieu. Tout comme Bienvenüe est un ingénieur. Donc deux scientifiques.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: Helvetica; font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: Helvetica; font-size: 20px;&quot;&gt;Et lorsque l&#39;on cherche la distance en trajet direct sur leur ligne, la 4, on obtient &lt;b&gt;11 min&lt;/b&gt;. Soit le temps qui était dit dans l&#39;énoncé. La subtilité du challenge était très sûrement ici.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="460.25" width="498" x="164" y="1708.88" as="geometry" />
        </mxCell>
        <mxCell id="XGDfcc4M_P-qUN3EE2EP-43" edge="1" parent="1" source="XGDfcc4M_P-qUN3EE2EP-39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="XGDfcc4M_P-qUN3EE2EP-41">
