        <mxCell id="mWK7CxRv2QZFlIvfYRCR-35" parent="1" style="text;html=1;align=center;verticalAlign=middle;rounded=0;strokeColor=default;glass=0;strokeWidth=1;fillColor=none;whiteSpace=wrap;sketch=1;curveFitting=1;jiggle=2;horizontal=1;convertToSvg=0;svgWhiteSpace=wrap;spacing=2;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Nous pouvons aussi pour vérifier, rentrer le nom de famille dans le registre des personnes énumé dans le cimetière de Pfastatt pour confirmer que la scientifique et son mari sont bels et bien enterré ici.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
