        <mxCell id="i8YLOUp-4RpA5gs-wDIp-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=center;verticalAlign=middle;rounded=0;sketch=1;curveFitting=1;jiggle=2;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Analyse de son fil twitter, et découverte d&#39;un tweet de sa part partageant son CV en image, et en réponse à ce tweet-ci, un lien vers son blog.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="433" x="2390.5" y="997" as="geometry" />
        </mxCell>
        <mxCell id="i8YLOUp-4RpA5gs-wDIp-11" edge="1" parent="1" source="i8YLOUp-4RpA5gs-wDIp-8" style="edgeStyle=orthogonalEdgeStyle;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="i8YLOUp-4RpA5gs-wDIp-10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="i8YLOUp-4RpA5gs-wDIp-8" parent="1" style="shape=image;aspect=fixed;image=data:image/png,;imageBorder=default;sketch=1;curveFitting=1;jiggle=2;" value="" vertex="1">
          <mxGeometry height="959.28" width="797" x="2208.5" y="1197" as="geometry" />
        </mxCell>
        <mxCell id="i8YLOUp-4RpA5gs-wDIp-13" edge="1" parent="1" source="i8YLOUp-4RpA5gs-wDIp-10" style="edgeStyle=orthogonalEdgeStyle;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="i8YLOUp-4RpA5gs-wDIp-12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="i8YLOUp-4RpA5gs-wDIp-10" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=center;verticalAlign=middle;rounded=0;sketch=1;curveFitting=1;jiggle=2;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Sur le CV partagé en photo dans le tweet, n&#39;est présent que deux langues ; Français et Anglais.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;J&#39;ai bien entendu pensée qu&#39;il serai trop simple que la langue recherché soit l&#39;Anglais mais j&#39;ai tout de même essayé pour être 100% que ce n&#39;était pas ça, et bien sûr, la langue recherchée n&#39;était pas l&#39;anglais. Allons désormais regarder sur le blog. Nous aurons très sûrement une piste qui nous mènera vers la véritable langue à trouver.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="216" width="545" x="1563" y="1568.6399999999999" as="geometry" />
        </mxCell>
        <mxCell id="i8YLOUp-4RpA5gs-wDIp-15" edge="1" parent="1" source="i8YLOUp-4RpA5gs-wDIp-12" style="edgeStyle=orthogonalEdgeStyle;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="i8YLOUp-4RpA5gs-wDIp-14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="i8YLOUp-4RpA5gs-wDIp-12" parent="1" style="shape=image;aspect=fixed;image=data:image/png,;imageBorder=default;sketch=1;curveFitting=1;jiggle=2;" value="" vertex="1">
          <mxGeometry height="452.67" width="800" x="663" y="1450.31" as="geometry" />
        </mxCell>
        <mxCell id="i8YLOUp-4RpA5gs-wDIp-36" edge="1" parent="1" source="i8YLOUp-4RpA5gs-wDIp-14" style="edgeStyle=orthogonalEdgeStyle;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="i8YLOUp-4RpA5gs-wDIp-35">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="i8YLOUp-4RpA5gs-wDIp-14" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=center;verticalAlign=middle;rounded=0;sketch=1;curveFitting=1;jiggle=2;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;Arrivé sur la page d&#39;accueil de son blog, nous allons nous rendre sur la page du lien hypertexte : &quot;&lt;b&gt;À propos de moi&lt;/b&gt;&quot;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90.36" width="377" x="186" y="1631.46" as="geometry" />
        </mxCell>
        <mxCell id="i8YLOUp-4RpA5gs-wDIp-31" edge="1" parent="1" source="i8YLOUp-4RpA5gs-wDIp-19" style="edgeStyle=orthogonalEdgeStyle;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="i8YLOUp-4RpA5gs-wDIp-21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="i8YLOUp-4RpA5gs-wDIp-19" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=center;verticalAlign=middle;rounded=0;sketch=1;curveFitting=1;jiggle=2;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;Indice tout de suite intéressant ; la dernière phrase de sa présentation :&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;&quot;Edit : j&#39;ai fais quelques typos et oublis sur mon CV précédent, le voilà corrigé ^^&quot;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="95.36" width="727" x="-678" y="2437" as="geometry" />
        </mxCell>
        <mxCell id="i8YLOUp-4RpA5gs-wDIp-32" edge="1" parent="1" source="i8YLOUp-4RpA5gs-wDIp-21" style="edgeStyle=orthogonalEdgeStyle;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="i8YLOUp-4RpA5gs-wDIp-23">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="i8YLOUp-4RpA5gs-wDIp-21" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=center;verticalAlign=middle;rounded=0;sketch=1;curveFitting=1;jiggle=2;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;Donc, intuitivement, on va aller chercher si possible, si le CV précédent existe quelque part, afin que nous ayons des informations pertinentes qui pourraient être relevés en lien avec notre enquête.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="95.36" width="727" x="-678" y="2675" as="geometry" />
        </mxCell>
        <mxCell id="i8YLOUp-4RpA5gs-wDIp-34" edge="1" parent="1" source="i8YLOUp-4RpA5gs-wDIp-23" style="edgeStyle=orthogonalEdgeStyle;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="i8YLOUp-4RpA5gs-wDIp-25">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="i8YLOUp-4RpA5gs-wDIp-23" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=center;verticalAlign=middle;rounded=0;sketch=1;curveFitting=1;jiggle=2;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;Son blog n&#39;ayant que peu d&#39;informations et interactions possibles, je me suis dis que s&#39;il avait mentionné le fait qu&#39;il a fait des modifications sur son CV précédent, c&#39;est qu&#39;il l&#39;avait déjà partagé sur son blog. Et que donc, cet ancien CV avait dû être disponible sur cette page-ci à un moment donné. J&#39;ai alors eu le réflexe d&#39;aller checker ça sur la Wayback Machine, afin de voir s&#39;il n&#39;y avait pas eu d&#39;enregistrement de cette page de son blog où était présent à ce moment son ancien CV.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="190.28" width="727" x="-680" y="2912.9999999999995" as="geometry" />
        </mxCell>
        <mxCell id="i8YLOUp-4RpA5gs-wDIp-28" edge="1" parent="1" source="i8YLOUp-4RpA5gs-wDIp-25" style="edgeStyle=orthogonalEdgeStyle;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="i8YLOUp-4RpA5gs-wDIp-27">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="i8YLOUp-4RpA5gs-wDIp-25" parent="1" style="shape=image;aspect=fixed;image=data:image/png,;imageBorder=default;sketch=1;curveFitting=1;jiggle=2;" value="" vertex="1">
          <mxGeometry height="822.62" width="800" x="186" y="2596.8300000000004" as="geometry" />
        </mxCell>
        <mxCell id="i8YLOUp-4RpA5gs-wDIp-39" edge="1" parent="1" source="i8YLOUp-4RpA5gs-wDIp-27" style="edgeStyle=orthogonalEdgeStyle;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="i8YLOUp-4RpA5gs-wDIp-38">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="i8YLOUp-4RpA5gs-wDIp-27" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=center;verticalAlign=middle;rounded=0;sketch=1;curveFitting=1;jiggle=2;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;Eh bien j&#39;eus raison d&#39;aller vérifier, car il existe bien un enregistrement de sa page de présentation début mai (le 7).&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;Et en cliquant dessus, voici comment était la page, et quel était le contenu de son CV :&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="544" x="1077" y="2948.1400000000003" as="geometry" />
        </mxCell>
        <mxCell id="i8YLOUp-4RpA5gs-wDIp-37" edge="1" parent="1" source="i8YLOUp-4RpA5gs-wDIp-35" style="edgeStyle=orthogonalEdgeStyle;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="i8YLOUp-4RpA5gs-wDIp-19">
