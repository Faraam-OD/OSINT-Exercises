        <mxCell id="42SLvFqF_o2kKIt09aSo-86" parent="1" style="shape=image;aspect=fixed;image=data:image/png,;imageBorder=default;sketch=1;curveFitting=1;jiggle=2;" value="" vertex="1">
          <mxGeometry height="500" width="800" x="350" y="3371" as="geometry" />
        </mxCell>
        <mxCell id="Q3mBBE4yDA58On71umiA-5" edge="1" parent="1" source="42SLvFqF_o2kKIt09aSo-92" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="42SLvFqF_o2kKIt09aSo-98">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="42SLvFqF_o2kKIt09aSo-92" parent="1" style="whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https://fonts.googleapis.com/css?family=Architects+Daughter;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;Tout d&#39;abord, la chose que je remarque, c&#39;est que la recherche n&#39;a pas eu l&#39;air de me trier comme il aurait fallu les critères/filtres que j&#39;ai inscrits dans ma recherche. Je suis passé de plus de 740 000 résultats à ~14 000, mais qui n&#39;affichent pas des résultats qui corrèlent aux critères de mes recherches.&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="155.5" width="612" x="-49" y="4395.25" as="geometry" />
        </mxCell>
        <mxCell id="Q3mBBE4yDA58On71umiA-7" edge="1" parent="1" source="42SLvFqF_o2kKIt09aSo-94" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="42SLvFqF_o2kKIt09aSo-100">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="42SLvFqF_o2kKIt09aSo-94" parent="1" style="whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https://fonts.googleapis.com/css?family=Architects+Daughter;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;J&#39;ai décidé alors de poursuivre mon investigation en me penchant sur le second site qui apparaîssait dans ma recherche Google, à savoir ; &lt;b&gt;la base nationale du Grand Mémorial sur le site des données du ministère de la culture&lt;/b&gt;.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="115" width="570" x="2332" y="4415.49" as="geometry" />
        </mxCell>
        <mxCell id="42SLvFqF_o2kKIt09aSo-95" edge="1" parent="1" source="42SLvFqF_o2kKIt09aSo-96" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="42SLvFqF_o2kKIt09aSo-94">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="42SLvFqF_o2kKIt09aSo-96" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;strokeColor=default;rounded=0;sketch=1;curveFitting=1;jiggle=2;" value="&lt;span style=&quot;color: rgb(255, 255, 255); font-family: Helvetica; font-size: 20px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: justify; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;J&#39;ai alors tout de même un peu avancé sur les pages, pour voir si je voyais des résultats comportant certains prénommés « Jean Roux ». Et, une fois après avoir obtenu des résultats ressemblant à mes recherches sur Jean Roux, je me suis rendu compte qu&#39;il en existait des dizaines, voire des centaines.&lt;/span&gt;" vertex="1">
          <mxGeometry height="137.75" width="595" x="1612" y="4404.13" as="geometry" />
        </mxCell>
        <mxCell id="42SLvFqF_o2kKIt09aSo-191" edge="1" parent="1" source="42SLvFqF_o2kKIt09aSo-98" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="42SLvFqF_o2kKIt09aSo-96">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
