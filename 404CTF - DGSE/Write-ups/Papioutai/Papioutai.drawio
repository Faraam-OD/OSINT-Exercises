        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-44" edge="1" parent="1" source="OcJFM1BSCdRdbJgofWJ5-43" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="OcJFM1BSCdRdbJgofWJ5-42">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-43" parent="1" style="whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;Je suis alors parti faire des recherches par indexation (Google Dorking) à partir des indices explicites que j&#39;avais à ma disposition. J&#39;ai découvert un résultat qui semblait m&#39;offrir des résultats pertinent.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="484" x="-371" y="568" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-51" edge="1" parent="1" source="OcJFM1BSCdRdbJgofWJ5-46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="OcJFM1BSCdRdbJgofWJ5-49">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-46" parent="1" style="shape=image;aspect=fixed;image=data:image/png,;imageBorder=default;sketch=1;curveFitting=1;jiggle=2;" value="" vertex="1">
          <mxGeometry height="500" width="800" x="395" y="999" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-57" edge="1" parent="1" source="OcJFM1BSCdRdbJgofWJ5-47" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="OcJFM1BSCdRdbJgofWJ5-54">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-47" parent="1" style="shape=image;aspect=fixed;image=data:image/png,;imageBorder=default;sketch=1;curveFitting=1;jiggle=2;" value="" vertex="1">
          <mxGeometry height="500" width="800" x="2535" y="999" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-52" edge="1" parent="1" source="OcJFM1BSCdRdbJgofWJ5-49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="OcJFM1BSCdRdbJgofWJ5-50">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-49" parent="1" style="whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;C&#39;est un extrait (le chapitre 6) d&#39;un livre d&#39;Agnès Graceffa intitulé : &lt;i&gt;&quot;Médiévistes en guerre : Un engagement patriotique. Analyse Comparée entre 1870-1871 et 1914-1918&quot;&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="484" x="1319" y="1179" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-53" edge="1" parent="1" source="OcJFM1BSCdRdbJgofWJ5-50" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="OcJFM1BSCdRdbJgofWJ5-47">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-50" parent="1" style="whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;Premier élément, tout d&#39;abord le contexte. Ici le titre de l&#39;ouvrage se prête au contexte de l&#39;enquête concernant la première guerre mondiale. J&#39;ai alors indexé sur la page le nom de Jean Roux (Ctrl + F) afin de voir si son nom apparaissait quelque part, et que si oui, il y aurait des informations le concernant.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="185" width="484" x="1927" y="1156.5" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-59" edge="1" parent="1" source="OcJFM1BSCdRdbJgofWJ5-54" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="OcJFM1BSCdRdbJgofWJ5-58">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-54" parent="1" style="whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;Son nom apparaît bien. Mais des Jean Roux il y en a plusieurs. Cependant, ce qui retient mon intention quant à ce Jean Roux présent dans ce texte, c&#39;est l&#39;indication&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 20px; font-family: Helvetica;&quot;&gt;&amp;nbsp;dans le paragraphe où ce dernier est mentionné, où il est dit que &lt;i&gt;&quot;Début 1915, cinquante élèves &lt;/i&gt;&lt;/span&gt;&lt;b style=&quot;font-style: italic; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 20px; font-family: Helvetica;&quot;&gt;normaliens&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 20px; font-family: Helvetica;&quot;&gt;&lt;i&gt; qui sont tombé au champs d&#39;honneur.&quot;&lt;/i&gt;&amp;nbsp;&lt;br&gt;&lt;br&gt;Cela se peut-il que ce soit le Jean Roux que nous recherchons ? Peut-être. Dans tous les cas, nous n&#39;aurons pas plus d&#39;informations que ce maigre détail qu&#39;une possible date de décès.&amp;nbsp;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="320" width="484" x="3459" y="1089" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-62" edge="1" parent="1" source="OcJFM1BSCdRdbJgofWJ5-58" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="OcJFM1BSCdRdbJgofWJ5-61">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-58" parent="1" style="whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;Je vais alors opter pour une approche différente, celle d&#39;une recherche dans l&#39;annuaire de l&#39;ENS. Action qui en effet, aurait pu être faite plus tôt.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="484" x="4067" y="1199" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-68" edge="1" parent="1" source="OcJFM1BSCdRdbJgofWJ5-61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="OcJFM1BSCdRdbJgofWJ5-65">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-61" parent="1" style="shape=image;aspect=fixed;image=data:image/png,;imageBorder=default;sketch=1;curveFitting=1;jiggle=2;" value="" vertex="1">
          <mxGeometry height="500" width="800" x="4675" y="998.9999999999999" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-71" edge="1" parent="1" source="OcJFM1BSCdRdbJgofWJ5-63" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="OcJFM1BSCdRdbJgofWJ5-70">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-63" parent="1" style="shape=image;aspect=fixed;image=data:image/png,;imageBorder=default;sketch=1;curveFitting=1;jiggle=2;" value="" vertex="1">
          <mxGeometry height="500" width="800" x="4675" y="1836" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-69" edge="1" parent="1" source="OcJFM1BSCdRdbJgofWJ5-65" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="OcJFM1BSCdRdbJgofWJ5-63">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-65" parent="1" style="whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;J&#39;ai d&#39;abord rechercher sur le premier résultat qui était montré, à savoir &quot;Annuaire | ENS&quot;, mais je n&#39;ai pas réussi à trouver quoi que ce soit de probant. J&#39;ai alors regardé le deuxième résultat, et tout de suite j&#39;ai remarqué un indice qui a de son importance ; &quot;&lt;b&gt;Ulm&lt;/b&gt;&quot;.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 20px; font-family: Helvetica;&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;&lt;font style=&quot;color: rgb(204, 204, 204);&quot;&gt;|&lt;/font&gt;&lt;i&gt;&lt;font style=&quot;color: rgb(204, 204, 204);&quot;&gt;&amp;nbsp;&quot;&lt;/font&gt;&lt;font style=&quot;color: rgb(204, 204, 204);&quot;&gt;Jean Roux, ancien &lt;b&gt;Ulmien&lt;/b&gt; mort pour la France [...]&quot;&lt;/font&gt;&lt;/i&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="175" width="484" x="4833" y="1580" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-73" edge="1" parent="1" source="OcJFM1BSCdRdbJgofWJ5-70" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="OcJFM1BSCdRdbJgofWJ5-72">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-70" parent="1" style="whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;Et en inscrivant justement le nom de Jean Roux dans la barre de recherche de l&#39;annuaire, voici le résultat que nous parvenons à découvrir :&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="484" x="4100" y="2036" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-75" edge="1" parent="1" source="OcJFM1BSCdRdbJgofWJ5-72" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="OcJFM1BSCdRdbJgofWJ5-74">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-72" parent="1" style="shape=image;aspect=fixed;image=data:image/png,;imageBorder=default;sketch=1;curveFitting=1;jiggle=2;" value="" vertex="1">
          <mxGeometry height="500" width="800" x="3209" y="1836" as="geometry" />
        </mxCell>
        <mxCell id="pOZUBeOs0rODmWMb6yA4-5" edge="1" parent="1" source="OcJFM1BSCdRdbJgofWJ5-74" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="pOZUBeOs0rODmWMb6yA4-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-74" parent="1" style="whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;Il y a un bien un dénommé Jean Roux, qui appartenait à la &lt;b&gt;promotion littéraire concours &quot;Ulm&quot; en 1912&lt;/b&gt;. Nous pouvons être en partie sûr de notre résultat. Ce dernier concordant pour le moment très possiblement la première réponse de l&#39;enquête à savoir son année de promotion.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="175" width="484" x="2634" y="1998.5" as="geometry" />
        </mxCell>
        <mxCell id="jQbVFK2koHJs73cqwuDx-4" edge="1" parent="1" source="pOZUBeOs0rODmWMb6yA4-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="jQbVFK2koHJs73cqwuDx-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pOZUBeOs0rODmWMb6yA4-1" parent="1" style="shape=image;aspect=fixed;image=data:image/png,;imageBorder=default;sketch=1;curveFitting=1;jiggle=2;" value="" vertex="1">
          <mxGeometry height="500" width="800" x="18" y="1836" as="geometry" />
        </mxCell>
        <mxCell id="pOZUBeOs0rODmWMb6yA4-6" edge="1" parent="1" source="pOZUBeOs0rODmWMb6yA4-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="pOZUBeOs0rODmWMb6yA4-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pOZUBeOs0rODmWMb6yA4-2" parent="1" style="whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https://fonts.googleapis.com/css?family=Architects+Daughter;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;Par la suite, avec cette nouvelle donnée, je suis revenu sur la piste qui concernait la mention de Jean Roux comme élève normaliens tombé au combat afin de voir si je n&#39;avais pas loupé une info.&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="484" x="2059" y="2026" as="geometry" />
        </mxCell>
        <mxCell id="pOZUBeOs0rODmWMb6yA4-9" edge="1" parent="1" source="pOZUBeOs0rODmWMb6yA4-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="pOZUBeOs0rODmWMb6yA4-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pOZUBeOs0rODmWMb6yA4-4" parent="1" style="whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https://fonts.googleapis.com/css?family=Architects+Daughter;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-family: Helvetica; font-size: 20px; float: none; display: inline !important; color: rgb(255, 255, 255); background-color: rgb(27, 29, 30);&quot;&gt;Eh bien en y retournant, et en relisant plus attentivement le paragraphe où est mentionné le nom de Jean Roux, je me suis mis à faire le lien avec son année de promotion, car il est inscrit à la quatrième ligne de ce paragraphe &quot;[...] sur les six historiens de la promotion de &lt;/span&gt;&lt;b style=&quot;font-family: Helvetica; font-size: 20px; color: rgb(255, 255, 255); background-color: rgb(27, 29, 30);&quot;&gt;1912&lt;/b&gt;&lt;span style=&quot;font-family: Helvetica; font-size: 20px; float: none; display: inline !important; color: rgb(255, 255, 255); background-color: rgb(27, 29, 30);&quot;&gt;, un seul reste vivant.&quot; Ici je peux donc confirmer en ayant croiser deux sources, qu&#39;il y a bien un Jean Roux, élève de l&#39;ENS qui était dans la promotion de 1912.&lt;/span&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="230.95" width="484" x="1484" y="1970.52" as="geometry" />
        </mxCell>
        <mxCell id="pOZUBeOs0rODmWMb6yA4-13" edge="1" parent="1" source="pOZUBeOs0rODmWMb6yA4-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="pOZUBeOs0rODmWMb6yA4-12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pOZUBeOs0rODmWMb6yA4-14" edge="1" parent="1" source="pOZUBeOs0rODmWMb6yA4-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="pOZUBeOs0rODmWMb6yA4-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pOZUBeOs0rODmWMb6yA4-7" parent="1" style="whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https://fonts.googleapis.com/css?family=Architects+Daughter;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;Mais surtout, ce que j&#39;ai remarqué et qui pourrait me servir de pivot, c&#39;est l&#39;introduction du &quot;&lt;b&gt;Livre d&#39;or&lt;/b&gt;&quot;. Dans la deuxième ligne, je cite : &quot;Selon la liste donnée par le l&lt;b&gt;ivre d&#39;or&lt;/b&gt; de l&#39;École Pratique des hautes études.&quot;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="484" x="909" y="2010.99" as="geometry" />
        </mxCell>
        <mxCell id="pOZUBeOs0rODmWMb6yA4-12" parent="1" style="whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https://fonts.googleapis.com/css?family=Architects+Daughter;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-family: Helvetica; font-size: 20px;&quot;&gt;Alors certes, j&#39;aurai pu relever ces informations qui — vont sûrement être crucial — lors de ma première introduction de cette piste, mais comme il en est la preuve ici, retourner sur une piste et y prêter un œil plus attentif peut nous donner d&#39;autres indices que nous n&#39;aurions pas vu en premier lieu. C&#39;est donc la leçon que je tire ici.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="145.53" width="608" x="847" y="2201.47" as="geometry" />
        </mxCell>
        <mxCell id="jQbVFK2koHJs73cqwuDx-6" edge="1" parent="1" source="jQbVFK2koHJs73cqwuDx-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="jQbVFK2koHJs73cqwuDx-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="jQbVFK2koHJs73cqwuDx-3" parent="1" style="whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https://fonts.googleapis.com/css?family=Architects+Daughter;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;J&#39;ai alors cherché sur internet &quot;&lt;b&gt;livre d&#39;or de l&#39;école pratique des hautes études&lt;/b&gt;&quot;, mais je n&#39;ai pas trouvé de résultats intéressants qui me menait à ce que je cherchais. À savoir, un annuaire qui indexait les noms des étudiants de l&#39;ENS mort durant la première guerre mondiale.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="165" width="484" x="-557" y="2003.5" as="geometry" />
        </mxCell>
