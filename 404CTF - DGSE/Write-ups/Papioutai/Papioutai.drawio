          <mxGeometry height="500" width="800" x="4389" y="-718" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-22" edge="1" parent="1" source="OcJFM1BSCdRdbJgofWJ5-19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="OcJFM1BSCdRdbJgofWJ5-21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-19" parent="1" style="whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;J&#39;ai un résultat ! La commune de &lt;b&gt;Courdemanges&lt;/b&gt;. Je vais maintenant creuser la piste de Jean Roux, décédé à Courdemanges. Allons voir sur Google Maps si on peut avoir plus d&#39;informations sur cette commune.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="597" x="4490.5" y="-145" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-24" edge="1" parent="1" source="OcJFM1BSCdRdbJgofWJ5-21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="OcJFM1BSCdRdbJgofWJ5-23">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-21" parent="1" style="shape=image;aspect=fixed;image=data:image/png,;imageBorder=default;sketch=1;curveFitting=1;jiggle=2;" value="" vertex="1">
          <mxGeometry height="500" width="800" x="4389" y="68" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-27" edge="1" parent="1" source="OcJFM1BSCdRdbJgofWJ5-23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="OcJFM1BSCdRdbJgofWJ5-25">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-23" parent="1" style="whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;Je me suis rendu compte en zoomant la commune qu&#39;il apparaîssait une sépulture de 1914. Indice qui n&#39;a pu que confirmer ma piste pour le lieu de décès de Jean Roux qui serait bien Courdemanges.&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="597" x="3719" y="248" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-29" edge="1" parent="1" source="OcJFM1BSCdRdbJgofWJ5-25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="OcJFM1BSCdRdbJgofWJ5-28">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-25" parent="1" style="shape=image;aspect=fixed;image=data:image/png,;imageBorder=default;sketch=1;curveFitting=1;jiggle=2;" value="" vertex="1">
          <mxGeometry height="500" width="800" x="2846" y="68" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-35" edge="1" parent="1" source="OcJFM1BSCdRdbJgofWJ5-28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="OcJFM1BSCdRdbJgofWJ5-34" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-28" parent="1" style="whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;Je me suis mis en street view afin de voir si j&#39;avais la possibilité d&#39;avoir un point de vue sur cette sépulture, mais je n&#39;ai eu aucune possibilité de la voir. J&#39;espérais trouver des informations sur Jean Roux notamment.&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="597" x="2176" y="248" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-37" edge="1" parent="1" source="OcJFM1BSCdRdbJgofWJ5-34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="OcJFM1BSCdRdbJgofWJ5-36">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-34" parent="1" style="whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;J&#39;ai alors fais mes recherche sur internet en cherchant si cette sépulture était présent quelque part. Je suis alors tombé sur ce résultat.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="484" x="1612" y="248" as="geometry" />
        </mxCell>
