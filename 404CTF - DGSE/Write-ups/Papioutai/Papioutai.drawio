        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-4" edge="1" parent="1" source="OcJFM1BSCdRdbJgofWJ5-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="OcJFM1BSCdRdbJgofWJ5-3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-1" parent="1" style="whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-family: Helvetica; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Ahlala, l&#39;ENS, cette école qui a produit tant d&#39;esprits savants ! Une amie aimerait que vous l&#39;aididez à retrouver des informations sur son bisaïeul, Jean Roux, ancien Ulmien mort pour la France en 14-18 dans un lieu dont le nom finit par demanges.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: Helvetica;&quot;&gt;Saurez-vous retrouver l&#39;année de promotion de Jean Roux, ainsi que sa ville de naissance ?&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-family: Helvetica; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-family: Helvetica; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Format : &lt;b&gt;404CTF{1876_saint-germain-en-hyères}&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="220" width="597" x="-282" y="-878" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-12" edge="1" parent="1" source="OcJFM1BSCdRdbJgofWJ5-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="OcJFM1BSCdRdbJgofWJ5-11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-2" parent="1" style="shape=image;aspect=fixed;image=data:image/png,;imageBorder=default;sketch=1;curveFitting=1;jiggle=2;" value="" vertex="1">
          <mxGeometry height="500" width="800" x="1072" y="-718" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-6" edge="1" parent="1" source="OcJFM1BSCdRdbJgofWJ5-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="OcJFM1BSCdRdbJgofWJ5-5" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-3" parent="1" style="whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;Les indices que nous pouvons d&#39;ores et déjà relever sont les suivants :&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;- nom de la personne recherchée ; &lt;b&gt;Jean Roux&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;- ce dernier était un ancien &lt;b&gt;Ulmien&lt;/b&gt; (&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 20px;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;terme désignant un élève ou un &lt;b&gt;ancien élève de l&#39;École normale supérieure&lt;/b&gt; de la rue d&#39;Ulm à Paris)&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 20px;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;- il est mort &lt;b&gt;pour la France&lt;/b&gt; durant la première guerre mondiale et dans un lieu qui termine par &quot;-&lt;b&gt;demanges&lt;/b&gt;&quot;.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="220" width="597" x="-282" y="-578" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-7" edge="1" parent="1" source="OcJFM1BSCdRdbJgofWJ5-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="OcJFM1BSCdRdbJgofWJ5-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-5" parent="1" style="whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;Ce que nous allons faire en premier lieu, va être de &lt;b&gt;connaître le lieu de sa mort&lt;/b&gt;. Chercher directement son nom dans le moteur de recherche accompagné de différents lien à la première guerre mondiale ne nous mènera nul part vu le nombre de Jean Roux qu&#39;il peut y avoir (ce dont j&#39;ai déjà testé bien entendu, et que l&#39;on verra dans tous les cas plus tard).&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="220" width="597" x="395" y="-578" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-14" edge="1" parent="1" source="OcJFM1BSCdRdbJgofWJ5-11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="OcJFM1BSCdRdbJgofWJ5-13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-11" parent="1" style="whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;Je suis tombé sur le site data.gouv.fr qui répertorie dans un fichier, CSV (ouvrable en tableur) toutes les communes française. À partir de ça, je vais pouvoir filtrer et indexer la (ou les) commune qui se finissent par &quot;-demanges&quot;.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="597" x="1952" y="-538" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-16" edge="1" parent="1" source="OcJFM1BSCdRdbJgofWJ5-13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="OcJFM1BSCdRdbJgofWJ5-15">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="OcJFM1BSCdRdbJgofWJ5-13" parent="1" style="shape=image;aspect=fixed;image=data:image/png,;imageBorder=default;sketch=1;curveFitting=1;jiggle=2;" value="" vertex="1">
          <mxGeometry height="500" width="800" x="2629" y="-718" as="geometry" />
