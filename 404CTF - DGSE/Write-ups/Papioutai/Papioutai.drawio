        </mxCell>
        <mxCell id="42SLvFqF_o2kKIt09aSo-129" parent="1" style="shape=image;aspect=fixed;image=data:image/png,;imageBorder=default;sketch=1;curveFitting=1;jiggle=2;" value="" vertex="1">
